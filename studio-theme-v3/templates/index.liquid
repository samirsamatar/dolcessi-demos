<footer class="ftr">
  <div class="wrap">
    <div class="ftr__mark" aria-hidden="true"><span class="w">dolcessi</span><span class="cur">_</span></div>
    <div class="ftr__grid mono">
      <div><span class="ftr__k" data-nl="Studio">Studio</span><span data-nl="Amsterdam (Amstelveen)">Amsterdam (Amstelveen)</span><span>AMS <time data-clock>--:--</time></span></div>
      <div><span class="ftr__k" data-nl="Contact">Contact</span><a href="mailto:info@dolcessi.com" data-cursor="HI">info@dolcessi.com</a><a href="https://concept.dolcessi.com/" target="_blank" rel="noopener">concept.dolcessi.com ↗</a></div>
      <div><span class="ftr__k" data-nl="Gegevens">Details</span><span>KvK 99514168</span><a href="https://dolcessi.com/policies/privacy-policy" data-nl="Privacybeleid">Privacy policy</a></div>
      <div><span class="ftr__k">© 2026 Dolcessi</span><span class="ftr__small" data-nl="Concepten zijn onofficieel en niet de eigen websites van de zaken.">Concepts are unofficial and not the places’ own websites.</span></div>
    </div>
  </div>
</footer>

<button type="button" class="dock btn btn--ember" data-ask aria-hidden="true" tabindex="-1"><span data-nl="Laat mijn site zien">Show me my site</span><span class="arr" aria-hidden="true">→</span></button>

<div class="ask" id="ask" role="dialog" aria-modal="true" aria-labelledby="ask-h1" hidden>
  <div class="ask__bg" data-close></div>
  <div class="ask__glow" aria-hidden="true"></div>
  <div class="ask__panel">
    <div class="ask__top mono">
      <span class="ask__t"><i class="live" aria-hidden="true"></i><span data-nl="Laat mijn site zien">Show me my site</span></span>
      <span class="ask__step" aria-live="polite"><b data-stepn>01</b> / 02</span>
      <button type="button" class="ask__x" data-close aria-label="Close" data-nl-aria-label="Sluiten"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="ask__bar" aria-hidden="true"><i data-bar></i></div>
    {% form 'contact', id: 'ask-form', class: 'ask-form', novalidate: 'novalidate' %}{% if form.posted_successfully? %}<i hidden data-sent></i>{% endif %}{% if form.errors %}<i hidden data-err>{{ form.errors | default_errors | strip_html | escape }}</i>{% endif %}
      <input type="hidden" name="contact[subject]" value="Show me my site">
      <div class="panes" data-panes>
      <div class="pane" data-pane="1">
        <h2 class="ask__h" id="ask-h1" data-nl="Welk <em>café of restaurant?</em>">Which <em>café or restaurant?</em></h2>
        <p class="ask__p" data-nl="Wij bouwen je site eerst. Jij ziet hem op je telefoon.">We build your site first. You see it on your phone.</p>
        <div class="fld">
          <input name="contact[restaurant]" id="f-rest" autocomplete="organization" maxlength="80" placeholder=" " aria-required="true" aria-describedby="e-rest">
          <label for="f-rest" data-nl="Café of restaurant">Café or restaurant</label>
          <span class="fld__err" id="e-rest" role="alert"></span>
        </div>
        <div class="fld">
          <input name="contact[neighbourhood]" id="f-area" maxlength="60" placeholder=" ">
          <label for="f-area"><span data-nl="Buurt">Neighbourhood</span> <i data-nl="(optioneel)">(optional)</i></label>
        </div>
        <div class="ask__row">
          <span class="ask__hint mono"><i aria-hidden="true"></i><span data-nl="Gratis · Vrijblijvend">Free · No obligation</span></span>
          <button type="button" class="btn btn--ember" data-next><span data-nl="Volgende">Next</span><span class="arr" aria-hidden="true">→</span></button>
        </div>
      </div>
      <div class="pane" data-pane="2" hidden>
        <h2 class="ask__h" data-nl="Waar sturen we <em>hem heen?</em>">Where do we <em>send it?</em></h2>
        <p class="ask__p" data-nl="We sturen je de link zodra je site klaar is.">We’ll send you the link when your site is ready.</p>
        <p class="ask__p ask__err" data-err-msg role="alert" hidden></p>
        <div class="fld">
          <input name="contact[name]" id="f-name" autocomplete="name" maxlength="60" placeholder=" " aria-required="true" aria-describedby="e-name">
          <label for="f-name" data-nl="Je naam">Your name</label>
          <span class="fld__err" id="e-name" role="alert"></span>
        </div>
        <div class="fld">
          <input type="email" name="contact[email]" id="f-email" autocomplete="email" maxlength="120" placeholder=" " aria-required="true" aria-describedby="e-email">
          <label for="f-email" data-nl="E-mail">Email</label>
          <span class="fld__err" id="e-email" role="alert"></span>
        </div>
        <div class="fld">
          <input type="tel" name="contact[phone]" id="f-phone" autocomplete="tel" maxlength="30" placeholder=" ">
          <label for="f-phone"><span data-nl="WhatsApp / telefoon">WhatsApp / phone</span> <i data-nl="(optioneel)">(optional)</i></label>
        </div>
        <input type="hidden" name="contact[body]" id="f-body">
        <div class="ask__row">
          <button type="button" class="link mono" data-back><span aria-hidden="true">←</span> <span data-nl="Terug">Back</span></button>
          <button type="submit" class="btn btn--ember"><span data-nl="Laat mijn site zien">Show me my site</span><span class="arr" aria-hidden="true">→</span></button>
        </div>
        <p class="fine ask__fine" data-nl="We gebruiken dit alleen om je je concept te sturen. <a href='https://dolcessi.com/policies/privacy-policy'>Privacy</a>">We only use this to send you your concept. <a href="https://dolcessi.com/policies/privacy-policy">Privacy</a></p>
      </div>
      <div class="pane pane--done" data-pane="3" hidden>
        <span class="done__tick" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="22"/><path d="M14 24.5l7 7 13-14"/></svg></span>
        <h2 class="ask__h ask__h--big" id="ask-h3" data-nl="De bon is binnen. <em>Je site staat op het vuur.</em>">Ticket’s in. <em>Your site’s on the stove.</em></h2>
        <p class="ask__p" data-nl="We gaan aan de slag en mailen je zodra hij klaar is. Vragen? <a href='mailto:info@dolcessi.com' data-cursor='HI'>info@dolcessi.com</a>">We’re on it, and we’ll email you when it’s ready. Questions? <a href="mailto:info@dolcessi.com" data-cursor="HI">info@dolcessi.com</a></p>
        <div class="ask__row"><span></span><button type="button" class="btn btn--bone" data-close><span data-nl="Terug naar de site">Back to the site</span></button></div>
      </div>
      </div>
    {% endform %}
  </div>
</div>

<div class="cursor" aria-hidden="true"><i class="cursor__dot"></i><i class="cursor__ring"><span class="cursor__lbl"></span></i></div>
<noscript><style>.pre{display:none}</style></noscript>
<script>(function(){var d=document,h=d.documentElement;if(!h.classList.contains('is-nl'))return;var a=d.querySelectorAll('[data-nl]'),i,e;for(i=0;i<a.length;i++){e=a[i];e._en=e.innerHTML;e.innerHTML=e.getAttribute('data-nl')}['aria-label','alt','placeholder','title'].forEach(function(k){var b=d.querySelectorAll('[data-nl-'+k+']');for(i=0;i<b.length;i++){e=b[i];e._enA=e._enA||{};e._enA[k]=e.getAttribute(k)||'';e.setAttribute(k,e.getAttribute('data-nl-'+k))}})})()</script>
</body>
</html>
