<!-- Show me my site: two-step form -->
<div class="askm" id="askm" role="dialog" aria-modal="true" aria-labelledby="askm-title" hidden>
  <div class="askm-bg" data-close></div>
  <div class="askm-panel">
    <button type="button" class="askm-x" data-close aria-label="Close">×</button>
    <div class="askm-prog"><i id="askm-bar"></i></div>
    {% form 'contact', id: 'ask-form', class: 'ask-form', data-mode: 'shopify', novalidate: 'novalidate' %}{% if form.posted_successfully? %}<i hidden data-sent></i>{% endif %}{% if form.errors %}<i hidden data-err>{{ form.errors | default_errors | strip_html | escape }}</i>{% endif %}
      <input type="hidden" name="contact[subject]" value="Show me my site">
      <div class="fstep is-on" data-step="1">
        <p class="label">Step 1 of 2</p>
        <h3 id="askm-title" data-nl="Hoe heet je &lt;em&gt;restaurant?&lt;/em&gt;">What’s your restaurant <em>called?</em></h3>
        <label class="fld"><span class="mono">Restaurant</span><input name="contact[restaurant]" id="f-rest" autocomplete="organization" placeholder="e.g. Hoi Tin Café" maxlength="80"></label>
        <label class="fld"><span class="mono">Neighbourhood <i>optional</i></span><input name="contact[neighbourhood]" id="f-area" placeholder="e.g. De Pijp" maxlength="60"></label>
        <div class="askm-row"><button type="button" class="btn" id="to2">Next <span class="arr">→</span></button></div>
      </div>
      <div class="fstep" data-step="2">
        <p class="label">Step 2 of 2</p>
        <h3 data-nl="Bijna klaar. &lt;em&gt;Waar sturen we hem heen?&lt;/em&gt;">Almost there. <em>Where do we send it?</em></h3>
        <p class="askm-hint" id="askm-hint">We’ll start sketching right away.</p>
        <label class="fld"><span class="mono">Your name</span><input name="contact[name]" id="f-name" autocomplete="name" placeholder="First name is fine" maxlength="60"></label>
        <label class="fld"><span class="mono">Email</span><input type="email" name="contact[email]" id="f-email" autocomplete="email" placeholder="you@restaurant.nl" maxlength="120"></label>
        <label class="fld"><span class="mono">WhatsApp / phone <i>optional</i></span><input type="tel" name="contact[phone]" id="f-phone" autocomplete="tel" placeholder="+31 6 …" maxlength="30"></label>
        <input type="hidden" name="contact[body]" id="f-body">
        <div class="askm-row"><button type="button" class="btn btn-o" id="back1">← Back</button><button type="submit" class="btn" id="send">Send it <span class="arr">→</span></button></div>
        <p class="askm-fine mono">We only use this to send you your site. No spam, no newsletter. <a href="https://dolcessi.com/policies/privacy-policy" target="_blank" rel="noopener" data-nl-skip>Privacy</a></p>
      </div>
      <div class="fstep" data-step="3">
        <p class="label live-c"><span class="live-dot"></span> Received</p>
        <h3 data-nl="Het staat op het vuur. &lt;em&gt;We gaan ervoor.&lt;/em&gt;">It’s on the stove. <em>We’re on it.</em></h3>
        <p class="askm-hint" id="askm-done">We’ll get back to you soon with your concept. Keep an eye on your inbox.</p>
        <div class="askm-row"><button type="button" class="btn" data-close>Back to the site</button></div>
      </div>
      <p class="askm-err mono" id="askm-err" role="alert" hidden></p>
    {% endform %}
  </div>
</div>

