<style>
/* v2.0 work cards: live pill, client-colour glow, feature line, more-work row */
.card-live{position:absolute;z-index:3;top:-12px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;padding:5px 10px 5px 8px;border-radius:999px;background:#0b0b0b;border:1px solid #3a3a3a;transition:border-color .5s;font-size:9px;letter-spacing:.2em;color:var(--bone);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.card-live .live-dot{width:6px;height:6px}
.card:hover .card-live{border-color:var(--acc,#3a3a3a)}
.card:hover .card-phone,.card:focus-visible .card-phone{border-color:var(--acc,#3a3a3a);box-shadow:0 40px 90px rgba(0,0,0,.65),0 0 80px color-mix(in srgb,var(--acc,#FF5A1F) 32%,transparent)}
.card:focus-visible{outline:none}
.card:focus-visible .card-phone img.alt{opacity:1}
.card-meta b{white-space:nowrap}
.card-feat{grid-column:1/-1;margin-top:6px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);display:flex;align-items:center;gap:8px}
.card-feat::before{content:"";width:14px;height:1px;background:var(--acc,var(--ember))}
.more-work{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);margin:-1vh 0 14px}
.more-work a{color:var(--bone);border-bottom:1px solid var(--line2);padding-bottom:2px;transition:color .25s,border-color .25s}
.more-work a:hover{color:var(--ember);border-color:var(--ember)}
.swipe-hint{display:none}
@media (max-width:900px){
  .swipe-hint{display:flex;justify-content:flex-end;gap:8px;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash);margin:-3vh 0 4vh}
  .swipe-hint span{color:var(--ember);animation:nudge 1.6s ease-in-out infinite}
  .card-phone{width:min(68vw,280px)}
  .deck{padding-top:16px}
  .more-work{line-height:2}
}
@keyframes nudge{50%{transform:translateX(5px)}}
</style>
{{ content_for_header }}
</head>
