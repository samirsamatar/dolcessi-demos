<!-- 07 PROOF -->
<section class="proof" id="proof">
  <div class="proof-head">
    <p class="label type">07 · Proof</p>
    <h2 class="split" data-nl="Geloof ons niet op ons woord. &lt;em&gt;Kijk zelf.&lt;/em&gt;">Don’t take our word for it. <em>Look.</em></h2>
  </div>
  <div class="proof-grid">
