<canvas id="field" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<div class="cursor" aria-hidden="true"><div class="cur-dot"></div><div class="cur-ring"><span class="cur-label"></span></div></div>

<!-- Preloader -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader-count"><span id="count">00</span></div>
